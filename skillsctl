#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILLS_DIR="$ROOT/skills"

usage() {
  cat <<'EOF'
Uso:
  skillsctl update
  skillsctl link-global [--force] [skill...]
  skillsctl link-project <proyecto> [--force] [skill...]
  skillsctl copy-project <proyecto> [--force] [skill...]
  skillsctl sync-globals [directorio]
  skillsctl sync-project <proyecto>
  skillsctl sync-external
  skillsctl sync-matt
  skillsctl sync-ecc
  skillsctl status

Sin una lista de skills, link-global/link-project/copy-project instalan todas.
EOF
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

skill_source() {
  local name="$1"
  local source="$SKILLS_DIR/$name"
  [[ -f "$source/SKILL.md" ]] || die "no existe la skill '$name'"
  printf '%s\n' "$source"
}

all_skill_names() {
  local source
  for source in "$SKILLS_DIR"/*; do
    [[ -f "$source/SKILL.md" ]] || continue
    basename "$source"
  done
}

parse_install_args() {
  FORCE=false
  SKILL_NAMES=()
  local arg
  for arg in "$@"; do
    case "$arg" in
      --force) FORCE=true ;;
      --*) die "opción desconocida: $arg" ;;
      *) SKILL_NAMES+=("$arg") ;;
    esac
  done

  if ((${#SKILL_NAMES[@]} == 0)); then
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      SKILL_NAMES+=("$name")
    done < <(all_skill_names)
  fi
}

link_skills() {
  local destination="$1"
  shift
  parse_install_args "$@"
  mkdir -p "$destination"

  local name source target resolved
  for name in "${SKILL_NAMES[@]}"; do
    source="$(skill_source "$name")"
    target="$destination/$name"

    if [[ -L "$target" ]]; then
      resolved="$(readlink -f "$target" || true)"
      if [[ "$resolved" == "$source" ]]; then
        printf 'ok      %s\n' "$name"
        continue
      fi
      ln -sfn "$source" "$target"
      printf 'enlace  %s -> %s\n' "$name" "$source"
      continue
    fi

    if [[ -e "$target" ]]; then
      if [[ "$FORCE" != true ]]; then
        printf 'omite   %s (ya existe; usa --force)\n' "$name" >&2
        continue
      fi
      rm -rf "$target"
    fi

    ln -s "$source" "$target"
    printf 'enlace  %s -> %s\n' "$name" "$source"
  done
}

copy_skills() {
  local destination="$1"
  shift
  parse_install_args "$@"
  mkdir -p "$destination"

  local name source target
  for name in "${SKILL_NAMES[@]}"; do
    source="$(skill_source "$name")"
    target="$destination/$name"

    if [[ -e "$target" || -L "$target" ]]; then
      if [[ "$FORCE" != true ]]; then
        printf 'omite   %s (ya existe; usa --force)\n' "$name" >&2
        continue
      fi
      rm -rf "$target"
    fi

    cp -aL "$source" "$target"
    printf 'copia   %s -> %s\n' "$name" "$target"
  done
}

sync_from() {
  local source_dir="$1"
  [[ -d "$source_dir" ]] || die "no existe el directorio: $source_dir"
  mkdir -p "$SKILLS_DIR"

  local source name destination resolved
  local imported=0
  local skipped=0
  for source in "$source_dir"/*; do
    [[ -f "$source/SKILL.md" ]] || continue
    name="$(basename "$source")"
    destination="$SKILLS_DIR/$name"
    resolved="$(readlink -f "$source")"

    case "$resolved" in
      "$SKILLS_DIR"|"$SKILLS_DIR"/*)
        printf 'omite   %s (ya enlazada a este repo)\n' "$name"
        skipped=$((skipped + 1))
        continue
        ;;
    esac

    rm -rf "$destination"
    cp -aL "$source" "$destination"
    printf 'importa %s\n' "$name"
    imported=$((imported + 1))
  done

  printf '\nImportadas: %d · Omitidas: %d\n' "$imported" "$skipped"
}

record_source() {
  local name="$1"
  local revision="$2"
  local path="$3"
  local lock="$ROOT/SOURCES.lock"
  touch "$lock"
  local temporary
  temporary="$(mktemp)"
  awk -F '\t' -v name="$name" -v revision="$revision" -v path="$path" '
    BEGIN { updated = 0 }
    $1 == name { print name "\t" revision "\t" path; updated = 1; next }
    { print }
    END { if (!updated) print name "\t" revision "\t" path }
  ' "$lock" > "$temporary"
  mv "$temporary" "$lock"
}

sync_matt() {
  local temp repo tag skill_md source name
  local -a removed=()
  temp="$(mktemp -d)"
  repo="$temp/mattpocock-skills"
  tag="$(
    git ls-remote --tags --refs https://github.com/mattpocock/skills.git 'refs/tags/v1.3.*' |
      awk -F/ '{ print $NF }' |
      sort -V |
      tail -n 1
  )"
  [[ -n "$tag" ]] || die "no hay ninguna etiqueta v1.3.x"
  git clone --quiet --depth 1 --branch "$tag" \
    https://github.com/mattpocock/skills.git "$repo"

  mkdir -p "$SKILLS_DIR" "$ROOT/sources"
  : > "$temp/current-skills"
  while IFS= read -r -d '' skill_md; do
    source="$(dirname "$skill_md")"
    name="$(basename "$source")"
    rm -rf "$SKILLS_DIR/$name"
    cp -a "$source" "$SKILLS_DIR/$name"
    printf '%s\n' "$name" >> "$temp/current-skills"
    printf 'importa %s\n' "$name"
  done < <(find "$repo/skills" -name SKILL.md -not -path '*/deprecated/*' -print0)

  if [[ -f "$ROOT/sources/mattpocock-skills.txt" ]]; then
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      if ! grep -Fxq "$name" "$temp/current-skills"; then
        rm -rf "$SKILLS_DIR/$name"
        removed+=("$name")
        printf 'retira  %s\n' "$name"
      fi
    done < "$ROOT/sources/mattpocock-skills.txt"
  fi
  sort -u "$temp/current-skills" > "$ROOT/sources/mattpocock-skills.txt"

  record_source "mattpocock/skills@$tag" \
    "$(git -C "$repo" rev-parse HEAD)" "skills"
  rm -rf "$temp"

  local destination target resolved
  destination="${AGENT_SKILLS_HOME:-$HOME/.agents/skills}"
  for name in "${removed[@]}"; do
    target="$destination/$name"
    [[ -L "$target" ]] || continue
    resolved="$(readlink "$target")"
    [[ "$resolved" == "$SKILLS_DIR/$name" ]] || continue
    rm "$target"
  done
}

retire_missing() {
  local manifest="$1"
  local current="$2"
  local destination="${AGENT_SKILLS_HOME:-$HOME/.agents/skills}"
  local name target resolved
  [[ -f "$manifest" ]] || return 0
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    if grep -Fxq "$name" "$current"; then
      continue
    fi
    rm -rf "$SKILLS_DIR/$name"
    printf 'retira  %s\n' "$name"
    target="$destination/$name"
    [[ -L "$target" ]] || continue
    resolved="$(readlink "$target")"
    [[ "$resolved" == "$SKILLS_DIR/$name" ]] || continue
    rm "$target"
  done < "$manifest"
}

sync_ecc() {
  local temp repo current
  temp="$(mktemp -d)"
  repo="$temp/ecc"
  current="$temp/current-skills"
  git clone --quiet --depth 1 --filter=blob:none --sparse \
    https://github.com/affaan-m/ecc.git "$repo"
  git -C "$repo" sparse-checkout set skills
  sync_from "$repo/skills"
  find "$repo/skills" -mindepth 2 -maxdepth 2 -name SKILL.md -printf '%h\n' |
    xargs -n1 basename |
    sort -u > "$current"
  mkdir -p "$ROOT/sources"
  retire_missing "$ROOT/sources/affaan-m-ecc.txt" "$current"
  cp "$current" "$ROOT/sources/affaan-m-ecc.txt"
  record_source "affaan-m/ecc" "$(git -C "$repo" rev-parse HEAD)" "skills"
  rm -rf "$temp"
}

sync_external() {
  local temp impeccable taste emil
  temp="$(mktemp -d)"
  trap 'rm -rf "$temp"' EXIT
  impeccable="$temp/impeccable"
  taste="$temp/taste-skill"
  emil="$temp/emil-skill"

  git clone --quiet --depth 1 https://github.com/pbakaus/impeccable.git "$impeccable"
  git clone --quiet --depth 1 https://github.com/Leonxlnx/taste-skill.git "$taste"
  git clone --quiet --depth 1 https://github.com/emilkowalski/skill.git "$emil"

  sync_from "$impeccable/.agents/skills"
  sync_from "$taste/skills"

  # Ya existe una skill distinta llamada "prototype"; conservamos ambas.
  mv "$emil/skills/prototype" "$emil/skills/emil-prototype"
  python3 - "$emil/skills/emil-prototype/SKILL.md" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
old = "\nname: prototype\n"
if old not in text:
    raise SystemExit("No se encontró el nombre esperado en prototype de Emil")
path.write_text(text.replace(old, "\nname: emil-prototype\n", 1), encoding="utf-8")
PY
  sync_from "$emil/skills"

  record_source "pbakaus/impeccable" \
    "$(git -C "$impeccable" rev-parse HEAD)" ".agents/skills"
  record_source "Leonxlnx/taste-skill" \
    "$(git -C "$taste" rev-parse HEAD)" "skills"
  record_source "emilkowalski/skill" \
    "$(git -C "$emil" rev-parse HEAD)" "skills"
  sync_ecc
  sync_matt

  rm -rf "$temp"
  trap - EXIT
}

command="${1:-}"
[[ -n "$command" ]] || {
  usage
  exit 1
}
shift

case "$command" in
  update)
    git -C "$ROOT" pull --ff-only
    ;;
  link-global)
    link_skills "${AGENT_SKILLS_HOME:-$HOME/.agents/skills}" "$@"
    ;;
  link-project)
    (($# >= 1)) || die "falta la ruta del proyecto"
    project="$1"
    shift
    link_skills "$(cd "$project" && pwd)/.cursor/skills" "$@"
    ;;
  copy-project)
    (($# >= 1)) || die "falta la ruta del proyecto"
    project="$1"
    shift
    copy_skills "$(cd "$project" && pwd)/.cursor/skills" "$@"
    ;;
  sync-globals)
    global_source="${1:-$HOME/.agents/skills}"
    sync_from "$global_source"
    link_skills "$global_source" --force
    ;;
  sync-project)
    (($# == 1)) || die "indica exactamente una ruta de proyecto"
    project="$(cd "$1" && pwd)"
    sync_from "$project/.cursor/skills"
    ;;
  sync-external)
    (($# == 0)) || die "sync-external no acepta argumentos"
    sync_external
    link_skills "${AGENT_SKILLS_HOME:-$HOME/.agents/skills}" --force
    ;;
  sync-matt)
    (($# == 0)) || die "sync-matt no acepta argumentos"
    sync_matt
    link_skills "${AGENT_SKILLS_HOME:-$HOME/.agents/skills}" --force
    ;;
  sync-ecc)
    (($# == 0)) || die "sync-ecc no acepta argumentos"
    sync_ecc
    link_skills "${AGENT_SKILLS_HOME:-$HOME/.agents/skills}" --force
    ;;
  status)
    git -C "$ROOT" status --short
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage >&2
    die "comando desconocido: $command"
    ;;
esac
